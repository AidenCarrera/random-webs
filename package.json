    "matter-js": "^0.20.0",
    "motion": "^14.0.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-share": "^5.3.0",
    "react-webcam": "^7.2.0",
    "three": "^0.186.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
