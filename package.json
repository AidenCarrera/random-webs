    "test:smoke:production": "node scripts/test-smoke.ts --production",
    "generate:demo-log": "node scripts/generate-demo-git-log.ts",
    "update:last-modified": "node scripts/update-last-modified.ts",
    "typecheck": "tsc --noEmit",
    "open:websites": "node scripts/open-websites.ts",
